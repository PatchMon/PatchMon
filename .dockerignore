# Environment files
**/.env
**/.env.*

# Node modules
**/node_modules

# Logs
**/logs
**/*.log

# Git
**/.git
**/.gitignore
.git-moved

# IDE files
**/.vscode
**/.idea
**/*.swp
**/*.swo

# OS files
**/.DS_Store
**/Thumbs.db

# Build artifacts
**/dist
**/build
**/coverage

# Go binaries and test artifacts (built during Docker build, not from repo).
# Scoped to agent-source-code instead of **/*.exe + a !agents-prebuilt
# negation: any negation forces the context walker to descend into excluded
# directories, which fails on unreadable dev data (compose_dev_data/db).
agent-source-code/**/*.exe
**/*.test
**/*.out
**/*.prof
**/patchmon-server
**/patchmon-server-*
# Exclude agent binaries from agents/ (they're copied from agents-prebuilt/ instead)
# but keep agents/ scripts (install, remove, etc.)
agents/patchmon-agent-*

# Temporary files
**/tmp
**/temp

# Docker compose dev data (volumes)
docker/compose_dev_data
**/compose_dev_data
