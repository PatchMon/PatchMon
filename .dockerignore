# Environment files
**/.env
**/.env.*

# Node modules
**/node_modules

# Logs
**/logs
**/*.log

# Git
**/.git
**/.gitignore
.git-moved

# Trusted CI action checkout (see .github/workflows/docker.yml)
.ci-trusted

# IDE files
**/.vscode
**/.idea
**/*.swp
**/*.swo

# OS files
**/.DS_Store
**/Thumbs.db

# Build artifacts
**/dist
**/build
**/coverage

# Go binaries and test artifacts (built during Docker build, not from repo)
**/*.exe
!agents-prebuilt/patchmon-agent-*.exe
**/*.test
**/*.out
**/*.prof
**/patchmon-server
**/patchmon-server-*
# Optional CI artifacts exported by container builds; ordinary builds use source.
!server-prebuilt/patchmon-server-linux-*
# Agents are built in a container or supplied explicitly as CI artifacts.
# Installation scripts are embedded from server-source-code/internal/agents/.
agents/patchmon-agent-*

# Temporary files
**/tmp
**/temp

# Docker compose dev data (volumes)
docker/compose_dev_data
**/compose_dev_data
