      path: '{{ item.path }}'
      create: false
      regexp: (?i)(?i)^\s*{{ "PermitEmptyPasswords"| regex_escape }}\s+
      state: absent
    with_items: '{{ _etc_ssh_sshd_config_d_has_parameter.files | default([]) }}'
    when: _etc_ssh_sshd_config_d_has_parameter.matched &gt; 0

